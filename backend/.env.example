# ==========================================
# GEOTERA BACKEND ENVIRONMENT VARIABLES
# ==========================================

DEBUG=True
SECRET_KEY=geotera-dev-secret-key-super-secure-change-in-production

# Supabase PostgreSQL Connection
# For Direct DB Connection (Port 5432) or Pooler (Port 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres
# Leave DATABASE_URL blank to automatically fallback to local SQLite for instant testing

# Redis Telemetry & Channels Layer
REDIS_URL=redis://127.0.0.1:6379/0

# Supabase Auth / Storage
SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# Google Maps / Mapbox
GOOGLE_MAPS_API_KEY=AIzaSy...

# Server Host & Ports
HOST=0.0.0.0
PORT=8000

